src := @module_root@
obj-m += phoenixfs.o

KVER ?= $(shell uname -r)
ccflags-y += @module_ccflags@ -I@module_root@

PHXFS_VENDOR_SOURCE := $(patsubst %.o,%.c,@VENDOR_BACKEND@)
PHXFS_SOURCE_FILES := phxfs-mem.c phxfs-backend.c $(PHXFS_VENDOR_SOURCE) phxfs.c phxfs-p2p-service.c phxfs-p2pdma.c

phoenixfs-objs := phxfs-mem.o phxfs-backend.o @VENDOR_BACKEND@ phxfs.o phxfs-p2p-service.o phxfs-p2pdma.o
KERNEL_SRC := /lib/modules/$(KVER)/build
PAT_MEMTYPE_SOURCE := /sys/kernel/debug/x86/pat_memtype_list
PAT_MEMTYPE_SNAPSHOT := /run/phxfs/pat_memtype_list

.PHONY: all phxfs configure prepare_sources refresh-pat-snapshot insmod insmod-staging insmod-full rmmod install clean

all: phxfs

phxfs: configure
	$(MAKE) -C $(KERNEL_SRC) M=@module_output@ modules KBUILD_EXTRA_SYMBOLS=@VENDOR_KERNEL_MODULE@

# Recent kbuild versions resolve external-module sources relative to M= and no
# longer honor the legacy `src :=` redirect above. Keep the sources visible in
# the output directory so both old and new kernels use the same Makefile.
ifneq ($(abspath @module_output@),$(abspath @module_root@))
prepare_sources:
	@for file in $(PHXFS_SOURCE_FILES); do \
		ln -sfn "@module_root@/$$file" "@module_output@/$$file"; \
	done
else
prepare_sources:
	@:
endif

configure: prepare_sources
	@ @module_root@/configure $(KVER) @module_root@

# kernel_read() cannot consume the legacy debugfs .read implementation on
# modern kernels. Snapshot it from user space into a regular tmpfs file first.
# A failed refresh removes any stale snapshot but remains fail-open, matching
# the module's existing PAT preflight behavior.
refresh-pat-snapshot:
	@sudo sh -c '\
		set -eu; \
		src="$(PAT_MEMTYPE_SOURCE)"; \
		dst="$(PAT_MEMTYPE_SNAPSHOT)"; \
		dir="$${dst%/*}"; \
		install -d -m 0700 "$$dir"; \
		rm -f -- "$$dst"; \
		if [ ! -r "$$src" ]; then \
			echo ">> warning: cannot read $$src; PAT snapshot unavailable" >&2; \
			exit 0; \
		fi; \
		tmp=$$(mktemp "$$dir/.pat_memtype_list.XXXXXX"); \
		trap "rm -f -- '\''$$tmp'\''" EXIT HUP INT TERM; \
		if ! cat "$$src" > "$$tmp" || [ ! -s "$$tmp" ]; then \
			echo ">> warning: failed to capture $$src; PAT snapshot unavailable" >&2; \
			exit 0; \
		fi; \
		chmod 0400 "$$tmp"; \
		mv -f "$$tmp" "$$dst"; \
		trap - EXIT HUP INT TERM; \
		echo ">> refreshed PAT snapshot: $$dst"'

# Optional MAP_MODE=0|1 overrides the baked-in default BAR map mode for this load
# (e.g. `make insmod MAP_MODE=0`). Empty -> load the cmake-configured default.
# Optional DEBUG_MODE=0|1 applies to every insmod* target and toggles the
# phxfs_debug module param (phxfs_info logging). Empty -> module default (0).
# Runtime toggle without a reload:
#   echo 1 > /sys/module/phoenixfs/parameters/phxfs_debug
insmod: refresh-pat-snapshot
	sudo insmod phoenixfs.ko $(if $(strip $(MAP_MODE)),phxfs_map_mode=$(strip $(MAP_MODE)),) $(if $(strip $(DEBUG_MODE)),phxfs_debug=$(strip $(DEBUG_MODE)),)
# Named targets so the mode is TAB-completable (make completes target names,
# not VAR=val assignments).
insmod-staging: refresh-pat-snapshot
	sudo insmod phoenixfs.ko phxfs_map_mode=1 $(if $(strip $(DEBUG_MODE)),phxfs_debug=$(strip $(DEBUG_MODE)),)
insmod-full: refresh-pat-snapshot
	sudo insmod phoenixfs.ko phxfs_map_mode=0 $(if $(strip $(DEBUG_MODE)),phxfs_debug=$(strip $(DEBUG_MODE)),)
rmmod:
	sudo rmmod phoenixfs
install: refresh-pat-snapshot
	@if [ ! -f phoenixfs.ko ]; then \
		echo ">> phoenixfs.ko not found (build first, or module disabled); skipping"; \
		exit 0; \
	fi; \
	KREL=$$(uname -r); DEST=/lib/modules/$$KREL/extra; \
	echo ">> installing phoenixfs.ko -> $$DEST"; \
	if mkdir -p "$$DEST" 2>/dev/null && cp phoenixfs.ko "$$DEST/" 2>/dev/null; then \
		if depmod -a 2>/dev/null; then \
			echo ">> installed; load with: sudo modprobe phoenixfs"; \
		else \
			echo ">> copied, but 'depmod -a' failed (run: sudo depmod -a)"; \
		fi; \
	else \
		echo ">> kernel module install failed (need root / writable $$DEST)."; \
		echo ">> load in place instead: sudo insmod $(CURDIR)/phoenixfs.ko"; \
		exit 1; \
	fi
clean:
	rm -fr *.o *.ko *.mod* .*.cmd .*.d
