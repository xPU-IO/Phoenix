# Called by public make targets; dependency discovery occurs in this child build.
if(NOT PHXFS_COMPONENT OR NOT PHXFS_TARGET)
    message(FATAL_ERROR "BuildComponent requires a component and target")
endif()
if(PHXFS_TARGET STREQUAL "install" AND DEFINED CMAKE_INSTALL_PREFIX)
    set(install_prefix "${CMAKE_INSTALL_PREFIX}")
endif()
include("${PHXFS_SETTINGS}")
if(DEFINED install_prefix)
    set(CMAKE_INSTALL_PREFIX "${install_prefix}")
endif()
file(LOCK "${PHXFS_OUTPUT_DIR}/.components/${PHXFS_COMPONENT}.lock" GUARD PROCESS TIMEOUT 600)
set(args)
foreach(name IN LISTS PHXFS_FORWARDED_VARIABLES)
    if(PHXFS_COMPONENT STREQUAL "module" AND NOT name MATCHES "^(PHXFS_ROOT|PHXFS_OUTPUT_DIR|PHXFS_VENDOR|PHXFS_EXTRA_HEADERS|PHXFS_MAP_MODE|NVIDIA|KERNEL)$")
        continue()
    elseif(NOT PHXFS_COMPONENT STREQUAL "module" AND name MATCHES "^(NVIDIA|KERNEL|PHXFS_EXTRA_HEADERS|PHXFS_MAP_MODE|PHXFS_BUILD_JOBS|PHXFS_GENERATOR|PHXFS_MAKE)$")
        continue()
    elseif(NOT PHXFS_COMPONENT STREQUAL "gpu" AND name MATCHES "^CMAKE_(CUDA|HIP)_")
        continue()
    elseif(PHXFS_COMPONENT STREQUAL "library" AND name MATCHES "^(PHXFS_LIBRARY_FILE|TEST_FILE)$")
        continue()
    endif()
    string(REPLACE ";" "\\;" value "${${name}}")
    list(APPEND args "-D${name}=${value}")
endforeach()
set(child "${PHXFS_OUTPUT_DIR}/.components/${PHXFS_COMPONENT}")
if(PHXFS_COMPONENT STREQUAL "module")
    set(source "${PHXFS_ROOT}/cmake/module")
elseif(PHXFS_COMPONENT STREQUAL "library")
    set(source "${PHXFS_ROOT}/cmake/library")
elseif(PHXFS_COMPONENT STREQUAL "tools")
    set(source "${PHXFS_ROOT}/cmake/tools")
else()
    set(source "${PHXFS_ROOT}/cmake/tests")
    list(APPEND args "-DPHXFS_TEST_KIND=${PHXFS_COMPONENT}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${child}"
    -G "${PHXFS_GENERATOR}" --no-warn-unused-cli ${args} RESULT_VARIABLE result)
if(result)
    message(FATAL_ERROR "Dependency check failed for ${PHXFS_TARGET}; see the error above")
endif()
if(PHXFS_COMPONENT STREQUAL "module")
    execute_process(COMMAND "${PHXFS_MAKE}" -C "${PHXFS_OUTPUT_DIR}/module"
        "${PHXFS_TARGET}" "MAP_MODE=${MAP_MODE}" "DEBUG_MODE=${DEBUG_MODE}"
        RESULT_VARIABLE result)
elseif(PHXFS_TARGET STREQUAL "install")
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${child}"
        --prefix "${CMAKE_INSTALL_PREFIX}" RESULT_VARIABLE result)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${child}"
        --target "${PHXFS_TARGET}" --parallel "${PHXFS_BUILD_JOBS}" RESULT_VARIABLE result)
endif()
if(result)
    message(FATAL_ERROR "${PHXFS_TARGET} failed; see the error above")
endif()
